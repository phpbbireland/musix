{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musix",
  "version": "0.1.3",
  "identifier": "com.mike.musix",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Browse and play your music library",
    "longDescription": "Musix is a local music library browser and player. This desktop build runs the Musix web app in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
